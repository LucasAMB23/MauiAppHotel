<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.PedidoHospedagem"
             Title="PedidoHospedagem"
             BackgroundColor="{StaticResource OffBlack}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
    
    <VerticalStackLayout VerticalOptions="Center" Padding="8" Margin="5">
        <Label 
            Text="Cálculo da Diária"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontFamily="Nunito"
            FontSize="30"
            TextColor="AntiqueWhite"/>

        <Border BackgroundColor="{StaticResource Gray500}" Padding="8">
            <VerticalStackLayout Padding="5" HorizontalOptions="Center" >
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*,*,2*">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:"/>

                    <Label Grid.Row="1" Grid.Column="0"
       Text="Crianças:"/>

                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value}" BindingContext="{x:Reference stp_adultos}"/>

                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}" BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             BackgroundColor="Black"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" BackgroundColor="Black"/>
                </Grid>

                <Label Text="Escolha sua suíte"/>

                <Picker x:Name="picker_quarto" Title="Escolha seu quarto" BackgroundColor="Black" ItemDisplayBinding="{Binding Descricao}"/>


                <Border Padding="10" Margin="10">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Período de Estadia" HorizontalOptions="Center" Padding="5"/>
                        <HorizontalStackLayout>
                            <Label Text="Check-in:" Padding="10"/>
                            <DatePicker x:Name="dt_checkin" Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Check-out:" Padding="5"/>
                            <DatePicker x:Name="dt_checkout" Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                                      
                    
                </Border>

                <Button Text="Avançar" HorizontalOptions="Center" Clicked="Button_Clicked_1"/>

                <Button Text="Sobre" HorizontalOptions="Center"  TextColor="White" Background="Transparent" Clicked="Button_Clicked"/>



            </VerticalStackLayout>
            
        </Border>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>